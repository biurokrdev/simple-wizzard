# ===========================================
# D2ApiCreator Environment Variables Template
# ===========================================
# 
# Skopiuj ten plik jako .env i wypełnij prawdziwymi wartościami
# NIGDY nie commituj pliku .env do Git!
#

# Database Configuration
# -----------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=D2CreatorDb
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Connection String (alternatywnie możesz użyć powyższych osobno)
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=D2CreatorDb;Username=postgres;Password=your_password

# Application Environment
# ------------------------
ASPNETCORE_ENVIRONMENT=Development
# Opcje: Development, Staging, Production

# Application URLs
# ----------------
ASPNETCORE_URLS=https://localhost:5001;http://localhost:5000

# JWT Configuration (jeśli będziesz używać)
# -----------------------------------------
# JWT__Secret=your-super-secret-key-minimum-32-characters-long
# JWT__Issuer=D2ApiCreator
# JWT__Audience=D2ApiCreatorUsers
# JWT__ExpiryMinutes=60

# External Services (przykłady)
# ------------------------------
# SMTP__Host=smtp.gmail.com
# SMTP__Port=587
# SMTP__Username=your-email@gmail.com
# SMTP__Password=your-app-password
# SMTP__EnableSsl=true

# Azure Configuration (przykłady)
# --------------------------------
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...
# AZURE_KEY_VAULT_URI=https://your-keyvault.vault.azure.net/

# Redis Cache (przykład)
# -----------------------
# REDIS_CONNECTION_STRING=localhost:6379

# Logging
# -------
# Logging__LogLevel__Default=Information
# Logging__LogLevel__Microsoft.AspNetCore=Warning

# CORS (Production)
# -----------------
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

