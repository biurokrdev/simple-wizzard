{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "WorkerCatalog": {
    "BaseUrl": "",
    "ApiKey": "",
    "TimeoutSeconds": 15
  },
  "TargetApplication": {
    "PackageUrl": "",
    "ApiKey": "",
    "TimeoutSeconds": 60
  },
  "GoogleCloudStorage": {
    "BucketName": "d2creator-templates",
    "ApiEndpoint": "",
    "CredentialPath": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
