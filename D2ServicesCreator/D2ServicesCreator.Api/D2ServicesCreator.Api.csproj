<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>D2ServicesCreator.Api</RootNamespace>
    <AssemblyName>D2ServicesCreator.Api</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <InternalsVisibleTo>D2ServicesCreator.Tests.Unit</InternalsVisibleTo>
  </PropertyGroup>

  <!-- Package versions identical to D2ApiCreator.Api — both hosts share Application/Infrastructure. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\D2ApiCreator\D2ApiCreator.Application\D2ApiCreator.Application.csproj" />
    <ProjectReference Include="..\..\D2ApiCreator\D2ApiCreator.Infrastructure\D2ApiCreator.Infrastructure.csproj" />
  </ItemGroup>

</Project>
